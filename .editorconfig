# Módulo 1 del curso: la capa de calidad más barata que existe.
# Elimina la discusión de espacios/tabs y fin de línea en el code review.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
